{
  "manifestVersion": 1,
  "id": "yinian-feishu-project",
  "name": "飞书项目",
  "version": "0.3.0",
  "author": "vangelis",
  "description": "把飞书项目（Meegle）的排期与缺陷同步进一念：工作项成任务、每个排期节点成一个排期块，指派给你的缺陷单向同步成待办",
  "homepage": "https://github.com/VangelisHaha/yinian-plugin-feishu-project",
  "minHostVersion": "0.13.0",
  "runtime": {
    "kind": "process",
    "node": ">=20",
    "entry": {
      "default": "dist/main.mjs"
    }
  },
  "permissions": {
    "net": [
      "project.feishu.cn",
      "meegle.com"
    ],
    "spawn": [],
    "fs": [],
    "api": []
  },
  "contributes": {
    "sync": {
      "resources": [
        "task"
      ],
      "capabilities": {
        "actions": [
          "list",
          "complete",
          "reopen"
        ],
        "fields": [
          "title",
          "due_at",
          "schedule",
          "priority",
          "tags"
        ]
      }
    },
    "syncStrategy": {
      "modes": [
        "interval",
        "manual"
      ],
      "defaultIntervalSeconds": 900,
      "minIntervalSeconds": 300
    },
    "hooks": [],
    "settingsPanel": [
      "settings.plugin.json",
      "settings.integration.json"
    ],
    "agentTools": {
      "scope": "integration"
    }
  },
  "authMode": [
    "token"
  ]
}

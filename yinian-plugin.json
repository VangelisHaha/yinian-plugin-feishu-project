{
  "manifestVersion": 1,
  "id": "yinian-feishu-project",
  "name": "飞书项目",
  "version": "0.1.0",
  "author": "vangelis",
  "description": "把飞书项目（Meegle）的排期同步进一念：工作项成任务，每个排期节点成一个排期块",
  "homepage": "https://github.com/VangelisHaha/yinian-plugin-feishu-project",
  "minHostVersion": "0.5.4",
  "runtime": {
    "kind": "process",
    "node": ">=20",
    "entry": {
      "default": "dist/main.mjs"
    }
  },
  "permissions": {
    "net": ["project.feishu.cn", "meegle.com"],
    "spawn": [],
    "fs": [],
    "api": []
  },
  "contributes": {
    "sync": {
      "resources": ["task"],
      "capabilities": {
        "actions": ["list", "complete", "reopen"],
        "fields": ["title", "due_at", "schedule"]
      }
    },
    "syncStrategy": {
      "modes": ["interval", "manual"],
      "defaultIntervalSeconds": 900,
      "minIntervalSeconds": 300
    },
    "hooks": [],
    "settingsPanel": ["settings.plugin.json", "settings.integration.json"]
  },
  "authMode": ["token"]
}
